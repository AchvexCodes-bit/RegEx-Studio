# Copy to .env for local development and load it in your shell.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: set DEBUG=false and configure HTTPS / CSRF trusted origins.
CSRF_TRUSTED_ORIGINS=https://your-domain.example
# PostgreSQL configuration is planned; current default database is SQLite.
DATABASE_URL=
